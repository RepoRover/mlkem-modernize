# Simulated legacy weather station.
#
# The real target device is hardware-limited by the project premise and cannot
# perform ML-KEM. This host-built image does not emulate that hardware, so its
# timings or container quotas cannot establish target-hardware feasibility.
# Python 3.9 alone is also not proof of incapability: a current cryptography
# release can expose ML-KEM on that interpreter in the host environment.
#
# This image models additional field deployment constraints:
#
#   * the crypto dependency is pinned to an August 2021 build that predates
#     ML-KEM, and the image is immutable;
#   * the container has no route to a package index (see the internal network
#     in the compose file), so it cannot fetch a newer build;
#   * the root filesystem is read-only, so nothing can be installed at runtime.
#
# The gateway brokers the post-quantum link under the owner-provided hardware
# premise and these modeled deployment constraints.
FROM python:3.9-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Pinned first and installed with --no-deps below, so that installing our own
# packages can never silently pull a newer, PQC-capable build.
RUN pip install --no-cache-dir "cryptography==3.4.8"

COPY packages/pqcwire /app/packages/pqcwire
COPY packages/pqcnode /app/packages/pqcnode
COPY packages/pqcsuite /app/packages/pqcsuite
RUN pip install --no-cache-dir --no-deps \
        ./packages/pqcwire ./packages/pqcnode ./packages/pqcsuite

COPY services/__init__.py /app/services/__init__.py
COPY services/legacy_device /app/services/legacy_device

RUN useradd --create-home --uid 10001 device
USER device

CMD ["python", "-m", "services.legacy_device"]
