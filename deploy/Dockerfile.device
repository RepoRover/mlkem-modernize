# Simulated legacy weather station.
#
# What blocks this device from post-quantum cryptography is NOT its Python
# version and NOT its CPU budget. A current cryptography release installs
# happily on Python 3.9 and ML-KEM-768 keygen costs well under a millisecond,
# so neither would stop it. The real blockers are the ones that stop fielded
# hardware in practice:
#
#   * the crypto dependency is pinned to an August 2021 build that predates
#     ML-KEM, and the image is immutable;
#   * the container has no route to a package index (see the internal network
#     in the compose file), so it cannot fetch a newer build;
#   * the root filesystem is read-only, so nothing can be installed at runtime.
#
# This is why the gateway has to broker the post-quantum link: the limit is the
# update path, not the arithmetic. Claiming otherwise would be measurably false
# and the capability probe tests assert the accurate version.
FROM python:3.9-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Pinned first and installed with --no-deps below, so that installing our own
# packages can never silently pull a newer, PQC-capable build.
RUN pip install --no-cache-dir "cryptography==3.4.8"

COPY packages/wire /app/packages/wire
COPY packages/nodekit /app/packages/nodekit
COPY packages/cryptosuite /app/packages/cryptosuite
RUN pip install --no-cache-dir --no-deps \
        ./packages/wire ./packages/nodekit ./packages/cryptosuite

COPY services/__init__.py /app/services/__init__.py
COPY services/legacy_device /app/services/legacy_device

RUN useradd --create-home --uid 10001 device
USER device

CMD ["python", "-m", "services.legacy_device"]
