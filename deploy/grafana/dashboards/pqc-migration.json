{
  "title": "Post-Quantum Migration",
  "uid": "pqc-migration",
  "tags": ["pqc", "migration"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Quantum-vulnerable frames accepted by the CLOUD",
      "description": "The migration's success indicator. Scoped to the cloud on purpose: the cloud is the node we control end to end, so any non-zero value here means quantum-vulnerable traffic got all the way in. A cumulative counter is right for this question - 'has this EVER happened' - because one accepted frame is already a problem. Stays at 0 once the gateway speaks the post-quantum suite.",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(pqc_quantum_vulnerable_frames_total{service=\"cloud\"}) or vector(0)",
          "legendFormat": "accepted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last-mile exposure at the GATEWAY (expected)",
      "description": "Legacy frames the gateway accepts from the device. This is NOT a failure and will never reach zero: the device is frozen firmware that can only speak the legacy suite, so brokering means the gateway must accept it. Tracking it separately is the point - it quantifies the residual risk the migration does not remove. See docs/risks.md R1.",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "sum(pqc_quantum_vulnerable_frames_total{service=\"gateway\"}) or vector(0)",
          "legendFormat": "device link",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Suite in use per link",
      "description": "Which cipher suite each link is configured to use. The device link is expected to stay quantum-vulnerable: the device cannot be upgraded, so the gateway accepts its legacy suite and re-encrypts onward with the post-quantum one.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "pqc_suite_in_use",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true,
              "service": true
            },
            "indexByName": {
              "direction": 0,
              "suite": 1,
              "quantum_resistant": 2
            },
            "renameByName": {
              "direction": "Link",
              "suite": "Suite",
              "quantum_resistant": "Quantum-safe"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Link"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "downstream": {
                        "text": "device → gateway",
                        "index": 0
                      },
                      "upstream": {
                        "text": "gateway → cloud",
                        "index": 1
                      },
                      "inbound": {
                        "text": "cloud, inbound",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quantum-safe"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "yes",
                        "color": "green",
                        "index": 0
                      },
                      "false": {
                        "text": "no (expected)",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Suite"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "MLKEM768-X25519-HKDF-AESGCM": {
                        "text": "ML-KEM-768 + X25519",
                        "index": 0
                      },
                      "LEGACY-RSA2048-OAEP-AESGCM": {
                        "text": "RSA-2048 (legacy)",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Link",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Vulnerable frame rate, by service",
      "description": "Rate rather than cumulative total, so this answers 'is it happening right now'. The gateway line should be steady while the device transmits; the cloud line should sit flat on zero. If the cloud line ever lifts, the migration has regressed.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "sum by (service) (rate(pqc_quantum_vulnerable_frames_total[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 10}}}
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Frames accepted by the cloud, by suite",
      "description": "After migration this should be entirely post-quantum.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "sum by (suite) (pqc_frames_total{service=\"cloud\",result=\"accepted\"})",
          "legendFormat": "{{suite}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Handshakes at the cloud, by suite",
      "description": "How many key exchanges the cloud has completed and how long they took on average. Handshakes are rare by design: one session carries many readings and lasts up to 15 minutes, so a rate-based percentile would stay empty. The average over all handshakes is the honest number for this traffic.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "1000 * sum by (suite) (pqc_handshake_duration_seconds_sum{service=\"cloud\"}) / sum by (suite) (pqc_handshake_duration_seconds_count{service=\"cloud\"})",
          "legendFormat": "Average time, {{suite}}",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (suite) (pqc_handshake_duration_seconds_count{service=\"cloud\"})",
          "legendFormat": "Completed, {{suite}}",
          "instant": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*), MLKEM768-X25519-HKDF-AESGCM",
            "renamePattern": "$1, ML-KEM-768 + X25519"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*), LEGACY-RSA2048-OAEP-AESGCM",
            "renamePattern": "$1, RSA-2048 (legacy)"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Frame outcomes",
      "description": "A rise in rejected frames during a migration usually means a suite mismatch rather than an attack.",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "expr": "sum by (result) (rate(pqc_frames_total[1m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    }
  ]
}
