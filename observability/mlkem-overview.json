{
  "annotations": {"list": []},
  "description": "Live, local observability for the Device to Gateway to Cloud weather pipeline.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": {"type": "grafana", "uid": "-- Grafana --"},
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "content": "# ML-KEM observation pipeline\n`Device` **AES-256-GCM / TLS 1.2** → `Gateway` **decrypt + ML-KEM-768/HKDF/AES-GCM / TLS 1.3** → `Cloud` **decrypt** → `PostgreSQL`\n\nUse the **Logs** panel to follow an `observation_id`. Open **Explore → Tempo** for the trace waterfall and service graph. Telemetry contains identifiers and outcomes, never payloads, keys, tokens, or ciphertext.",
        "mode": "markdown"
      },
      "pluginVersion": "12.0.0",
      "title": "Data flow",
      "type": "text"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 4},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"cloud\"} | json | event=\"observation_stored\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Stored in selected range",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 6, "y": 4},
      "id": 3,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "sum by (service_name, event) (count_over_time({service_name=~\"$service\"} | json | event=~\"observation_(accepted|stored|duplicate|rejected)\" [$__interval]))",
          "legendFormat": "{{service_name}} {{event}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Observation outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 4},
      "id": 4,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "sum by (service_name, event) (count_over_time({service_name=~\"$service\"} | json | event=~\"(delivery|forwarding)_retry\" [$__interval]))",
          "legendFormat": "{{service_name}} {{event}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Retries",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 15, "x": 0, "y": 9},
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "{service_name=~\"$service\"} | json | line_format `{{.service}} {{.level}} {{.event}} observation={{.observation_id}} result={{.result}} trace={{.trace_id}}`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Live application logs",
      "type": "logs"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 9, "x": 15, "y": 9},
      "id": 6,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "limit": 20,
          "query": "{ resource.service.name =~ \"device|gateway|cloud\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Recent distributed traces",
      "transformations": [],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 19},
      "id": 7,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service_name}} server",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_client_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service_name}} client",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    }
  ],
  "refresh": "2s",
  "schemaVersion": 41,
  "tags": ["ml-kem", "opentelemetry", "demo"],
  "templating": {
    "list": [
      {
        "allValue": "device|gateway|cloud",
        "current": {"text": "All", "value": "$__all"},
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [
          {"selected": false, "text": "device", "value": "device"},
          {"selected": false, "text": "gateway", "value": "gateway"},
          {"selected": false, "text": "cloud", "value": "cloud"}
        ],
        "query": "device,gateway,cloud",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "ML-KEM Live Pipeline",
  "uid": "mlkem-live-pipeline",
  "version": 1,
  "weekStart": ""
}
